{
  "name": "ps5-launcher",
  "productName": "PS5 Launcher",
  "version": "1.4.0",
  "description": "PS5-style game launcher for Windows",
  "author": "SoFTeR1",
  "repository": "github:SoFTeR1/ps5-launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "assets": "electron build/make-assets.js",
    "dist": "electron build/make-assets.js && electron-builder --win nsis && node build/installer/build.js",
    "vendor": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/hls.js/dist/hls.min.js','renderer/vendor/hls.min.js');fs.copyFileSync('node_modules/nostr-tools/lib/nostr.bundle.js','renderer/vendor/nostr.bundle.js')\""
  },
  "build": {
    "appId": "local.ps5launcher",
    "productName": "PS5 Launcher",
    "copyright": "SoFTeR1",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PS5 Launcher",
      "uninstallDisplayName": "PS5 Launcher",
      "artifactName": "PS5-Launcher-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": ["ru_RU"],
      "language": "1049",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "SoFTeR1",
      "repo": "ps5-launcher"
    },
    "files": [
      "main.js",
      "preload.js",
      "steam.js",
      "system.js",
      "gamepad.js",
      "discord.js",
      "renderer/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "hls.js": "^1.7.4",
    "nostr-tools": "^2.25.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
